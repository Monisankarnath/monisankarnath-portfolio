---
interface Belief {
  statement: string;
  punchline: string;
}

const beliefs: Belief[] = [
  {
    statement: 'Think first, code second.',
    punchline: 'Design before implementation.',
  },
  {
    statement: 'Performance is a design decision.',
    punchline: 'Fast software is built, not fixed.',
  },
  {
    statement: 'Ship small, ship often.',
    punchline: 'Every step reviewable, reversible, shippable.',
  },
  {
    statement: 'Structure is respect.',
    punchline: 'The next engineer should understand in minutes.',
  },
  {
    statement: 'Every diff gets reviewed.',
    punchline: 'Especially my own.',
  },
  {
    statement: 'AI is a tool, not a crutch.',
    punchline: 'The decisions and ownership are mine.',
  },
];
---

<section id="how-i-work" class="how-i-work section">
  <h2 class="section-title">How I Work</h2>

  <div class="beliefs-grid">
    {beliefs.map((belief) => (
      <div class="belief">
        <span class="belief-statement">{belief.statement}</span>
        <span class="belief-punchline">{belief.punchline}</span>
      </div>
    ))}
  </div>
</section>

<style>
  .how-i-work {
    padding-block: var(--space-12);
  }

  .section-title {
    font-size: var(--text-h2);
    margin-bottom: var(--space-6);
  }

  .beliefs-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-1);
  }

  @media (min-width: 640px) {
    .beliefs-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-3);
    }
  }

  @media (min-width: 768px) {
    .beliefs-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .belief {
    padding: var(--space-4);
    border-radius: 0.5rem;
    transition: background-color var(--transition-fast);
  }

  .belief:hover {
    background-color: var(--color-bg-surface);
  }

  .belief-statement {
    display: block;
    font-size: var(--text-body);
    font-weight: 600;
    color: var(--color-text-primary);
    line-height: 1.3;
  }

  .belief-punchline {
    display: block;
    font-size: var(--text-small);
    color: var(--color-text-muted);
    margin-top: var(--space-1);
    line-height: 1.5;
  }

  @media (prefers-reduced-motion: reduce) {
    .belief {
      transition: none;
    }
  }
</style>
