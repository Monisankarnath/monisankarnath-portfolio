---
/**
 * How I Work Section
 * - Engineering beliefs/principles
 * - Hover reveals explanation (CSS-only)
 */

interface Belief {
  statement: string;
  explanation: string;
}

const beliefs: Belief[] = [
  {
    statement: 'Think first, code second.',
    explanation: 'I design the system — data flow, architecture, automation — before writing a single line. Good planning makes implementation feel inevitable, not improvised.',
  },
  {
    statement: 'Performance is a design decision.',
    explanation: 'Speed, memory, and efficiency are considered from the first commit, not patched in the last sprint. Fast software is built, not fixed.',
  },
  {
    statement: 'One module, one feature, one step.',
    explanation: 'Small, testable changes that compound into reliable systems. No big-bang releases. Every step is reviewable, reversible, and shippable.',
  },
  {
    statement: 'Structure is a form of respect.',
    explanation: 'Clean types, modular files, minimal code per file. The next engineer who opens this should understand it in minutes, not hours.',
  },
  {
    statement: 'Every diff gets reviewed — especially my own.',
    explanation: 'I test rigorously and read every line before committing. Bugs caught locally are exponentially cheaper than bugs in production.',
  },
  {
    statement: 'I use AI. I don\'t outsource judgment to it.',
    explanation: 'I\'ve been writing code since before AI assistants existed. I use them for reviews and iteration, but the logic, the decisions, and the ownership are mine.',
  },
];
---

<section class="how-i-work section">
  <h2 class="section-title">How I Work</h2>
  
  <ul class="beliefs">
    {beliefs.map((belief) => (
      <li class="belief">
        <span class="belief-statement">{belief.statement}</span>
        <span class="belief-explanation text-muted">{belief.explanation}</span>
      </li>
    ))}
  </ul>
</section>

<style>
  .how-i-work {
    border-top: 1px solid var(--color-border);
  }
  
  .section-title {
    font-size: var(--text-h2);
    margin-bottom: var(--space-8);
  }
  
  .beliefs {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  
  .belief {
    padding: var(--space-4);
    border-radius: 0.5rem;
    transition: background-color var(--transition-fast);
    cursor: default;
  }
  
  .belief:hover {
    background-color: var(--color-bg-surface);
  }
  
  .belief-statement {
    display: block;
    font-size: var(--text-body);
    font-weight: 500;
    color: var(--color-text-primary);
  }
  
  .belief-explanation {
    display: block;
    font-size: var(--text-small);
    line-height: 1.5;
    margin-top: var(--space-2);
    max-height: 0;
    overflow: hidden;
    opacity: 0;
    transition: max-height var(--transition-base), opacity var(--transition-base), margin-top var(--transition-base);
  }
  
  .belief:hover .belief-explanation {
    max-height: 100px;
    opacity: 1;
    margin-top: var(--space-2);
  }
  
  @media (prefers-reduced-motion: reduce) {
    .belief-explanation {
      transition: none;
    }
  }
</style>
