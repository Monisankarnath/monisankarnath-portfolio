---
import { PERSONAL_PROJECTS } from "../config/site";

const projects = PERSONAL_PROJECTS;
---

<section id="projects" class="projects section">
  <header class="section-header">
    <h2 class="section-title">Things I've Shipped</h2>
    <span class="section-line" aria-hidden="true"></span>
  </header>

  <div class="project-list">
    {projects.map((project, index) => (
      <article class={`project-card ${index % 2 === 1 ? 'reverse' : ''}`}>
        {project.liveUrl && (
          <a
            href={project.liveUrl}
            class="card-link-overlay"
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`Visit ${project.name}`}
          />
        )}
        <div class="project-image-wrap">
          <img
            src={project.image}
            alt={project.name}
            class="project-image"
            loading="lazy"
          />
        </div>

        <div class="project-content">
          <h3 class="project-name">{project.name}</h3>

          <div class="project-desc-card">
            <p class="project-desc">{project.description}</p>
          </div>

          <div class="project-tags">
            {project.tech.map((t) => (
              <span class="tag mono">{t}</span>
            ))}
          </div>

          {project.brands.length > 0 && (
            <div class="project-brands">
              {project.brands.map((brand, i) => (
                <>
                  <a href={brand.url} class="brand-link" target="_blank" rel="noopener noreferrer">{brand.name}</a>{i < project.brands.length - 1 && <span class="brand-sep"> · </span>}
                </>
              ))}
            </div>
          )}
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  .projects {
    padding-block: var(--space-16) var(--space-12);
  }

  .section-header {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    margin-bottom: var(--space-12);
  }

  .section-title {
    font-size: var(--text-h2);
    font-weight: 600;
    margin: 0;
    white-space: nowrap;
    color: var(--color-text-primary);
    letter-spacing: -0.02em;
  }

  .section-line {
    flex: 1;
    height: 1px;
    background-color: var(--color-border);
  }

  .card-link-overlay {
    position: absolute;
    inset: 0;
    z-index: 2;
    border-radius: inherit;
    text-decoration: none;
  }

  .project-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
  }

  .project-card {
    position: relative;
    border-radius: 0.625rem;
    box-shadow: 0 8px 40px rgba(0, 0, 0, 0.6), 0 0 0 1px rgba(255, 255, 255, 0.04);
    transition: box-shadow 0.4s ease, transform 0.3s ease;
  }

  .project-card:hover {
    box-shadow: 0 12px 48px rgba(0, 0, 0, 0.7), 0 0 0 1px rgba(96, 165, 250, 0.12);
    transform: translateY(-2px);
  }

  .project-image-wrap {
    position: absolute;
    inset: 0;
    z-index: 0;
    border-radius: inherit;
    overflow: hidden;
  }

  .project-image-wrap::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(14, 17, 22, 0.88), rgba(14, 17, 22, 0.95));
  }

  .project-image {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    opacity: 0.4;
  }

  .project-content {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-8) var(--space-6);
  }

  .project-name {
    font-size: var(--text-h2);
    font-weight: 600;
    margin: 0;
    color: var(--color-text-primary);
  }

  .project-desc-card {
    position: relative;
    z-index: 1;
    margin: var(--space-1) 0;
  }

  .project-desc {
    font-size: var(--text-body);
    line-height: 1.6;
    margin: 0;
    color: var(--color-text-secondary);
  }

  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-3);
  }

  .tag {
    font-size: var(--text-xs);
    color: var(--color-accent);
    white-space: nowrap;
  }

  .project-brands {
    font-size: var(--text-small);
    line-height: 1.8;
  }

  .brand-link {
    position: relative;
    z-index: 3;
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .brand-link:hover {
    color: var(--color-text-primary);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
  }

  .brand-sep {
    color: var(--color-text-muted);
    opacity: 0.3;
  }

  @media (min-width: 1000px) {
    .project-list {
      gap: var(--space-16);
    }

    .project-card {
      display: grid;
      grid-template-columns: 3fr 2fr;
      align-items: center;
      border-radius: 0;
      box-shadow: none;
    }

    .project-card.reverse {
      grid-template-columns: 2fr 3fr;
    }

    .project-card.reverse .project-image-wrap {
      order: 2;
    }

    .project-card.reverse .project-content {
      order: 1;
      align-items: flex-start;
      text-align: left;
    }

    .project-card:hover {
      box-shadow: none;
      transform: none;
    }

    .project-tags {
      justify-content: flex-end;
    }

    .project-card.reverse .project-tags,
    .project-card.reverse .project-brands {
      justify-content: flex-start;
    }

    .project-card.reverse .project-desc-card {
      margin-left: 0;
      margin-right: calc(-1 * var(--space-12));
    }

    .project-image-wrap {
      position: relative;
      inset: auto;
      border-radius: 0.5rem;
      overflow: hidden;
    }

    .project-image-wrap::after {
      display: none;
    }

    .project-image {
      aspect-ratio: 16 / 10;
      opacity: 1;
      filter: grayscale(1) brightness(0.4);
      transition: filter 0.5s ease;
    }

    .project-card:hover .project-image {
      filter: grayscale(0) brightness(1);
    }

    .project-content {
      padding: 0 var(--space-6) 0 0;
      gap: var(--space-3);
      align-items: flex-end;
      text-align: right;
    }

    .project-card.reverse .project-content {
      padding: 0 0 0 var(--space-6);
    }

    .project-desc-card {
      background: var(--color-bg-elevated);
      padding: var(--space-6);
      border-radius: 0.5rem;
      box-shadow: 0 10px 30px -15px rgba(0, 0, 0, 0.5);
      margin-left: calc(-1 * var(--space-12));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-image {
      transition: none;
    }
  }
</style>
