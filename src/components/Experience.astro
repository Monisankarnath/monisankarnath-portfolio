---
/**
 * Experience Snapshot
 * - Compact experience list
 * - Company, Role, Impact lines
 * - Scannable, not verbose
 */
import { RESUME } from "../config/site";

interface Experience {
  company: string;
  role: string;
  period: string;
  impact: string[];
}

const experiences: Experience[] = [
  {
    company: "GeekyAnts",
    role: "Senior Software Engineer",
    period: "2021 – Present",
    impact: [
      "Led mobile architecture for fleet tracking apps used by 50k+ drivers",
      "Built video caching layer handling HLS streams",
    ],
  }
];
---

<section class="experience section">
  <h2 class="section-title">Experience</h2>

  <div class="experience-list">
    {
      experiences.map((exp) => (
        <div class="experience-item">
          <div class="experience-header">
            <h3 class="company">{exp.company}</h3>
            <span class="period mono text-muted">{exp.period}</span>
          </div>
          <p class="role text-secondary">{exp.role}</p>
          <ul class="impact-list">
            {exp.impact.map((item) => (
              <li class="impact-item text-muted">{item}</li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>

  <a
    href={RESUME.path}
    class="btn btn-ghost resume-link"
    download
  >
    Download resume (PDF)
  </a>
</section>

<style>
  .experience {
    border-top: 1px solid var(--color-border);
  }

  .section-title {
    font-size: var(--text-h2);
    margin-bottom: var(--space-8);
  }

  .experience-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .experience-item {
    padding-bottom: var(--space-6);
    border-bottom: 1px solid var(--color-border);
  }

  .experience-item:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .experience-header {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-2);
    margin-bottom: var(--space-1);
  }

  .company {
    font-size: var(--text-h3);
    font-weight: 600;
  }

  .period {
    font-size: var(--text-small);
  }

  .role {
    font-size: var(--text-body);
    margin: 0 0 var(--space-3);
  }

  .impact-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .impact-item {
    font-size: var(--text-small);
    line-height: 1.5;
    padding-left: var(--space-4);
    position: relative;
  }

  .impact-item::before {
    content: "–";
    position: absolute;
    left: 0;
    color: var(--color-text-muted);
  }

  .resume-link {
    margin-top: var(--space-6);
  }
</style>
