---
interface Experience {
  company: string;
  role: string;
  period: string;
  impact: string[];
  tags: string[];
}

const experiences: Experience[] = [
  {
    company: "GeekyAnts",
    role: "Senior Software Engineer",
    period: "2021 – Present",
    impact: [
      "Led expo mobile architecture for fleet tracking apps used by 50k+ drivers",
      "Shipped an iOS payment SDK in Swift with StoreKit2",
      "Core contributor to Jio Design System across 500M+ download apps",
    ],
    tags: [
      "React Native",
      "Expo",
      "TypeScript",
      "Next.js",
      "Swift",
      "Nest.js",
      "Supabase",
    ],
  },
  {
    company: "Wipro",
    role: "Software Engineer",
    period: "2020 – 2021",
    impact: [
      "Worked as a HRMS technical Oracle EBS developer, building PL/SQL triggers and reports.",
    ],
    tags: ["SQL", "PL/SQL", "Oracle EBS", "Database"],
  },
];
---

<section id="experience" class="experience">
  <div class="experience-list">
    {
      experiences.map((exp) => (
        <div class="experience-item">
          <div class="experience-header">
            <h3 class="company">{exp.company}</h3>
            <span class="period mono text-muted">{exp.period}</span>
          </div>
          <p class="role text-secondary">{exp.role}</p>
          <ul class="impact-list">
            {exp.impact.map((item) => (
              <li class="impact-item text-muted">{item}</li>
            ))}
          </ul>
          {exp.tags.length > 0 && (
            <div class="tags-row">
              {exp.tags.map((tag) => (
                <span class="exp-tag">{tag}</span>
              ))}
            </div>
          )}
        </div>
      ))
    }
  </div>
</section>

<style>
  .experience {
    padding-block: var(--space-6) var(--space-12);
  }

  .experience-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .experience-item {
    padding-bottom: var(--space-6);
  }

  .experience-header {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-2);
    margin-bottom: var(--space-1);
  }

  .company {
    font-size: var(--text-h3);
    font-weight: 600;
  }

  .period {
    font-size: var(--text-small);
  }

  .role {
    font-size: var(--text-body);
    margin: 0 0 var(--space-3);
  }

  .impact-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .impact-item {
    font-size: var(--text-small);
    line-height: 1.5;
    padding-left: var(--space-4);
    position: relative;
  }

  .impact-item::before {
    content: "–";
    position: absolute;
    left: 0;
    color: var(--color-text-muted);
  }

  .tags-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-3);
  }

  .exp-tag {
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    padding: 2px var(--space-2);
    background-color: rgba(96, 165, 250, 0.08);
    border: 1px solid rgba(96, 165, 250, 0.15);
    border-radius: 9999px;
    color: var(--color-accent);
    white-space: nowrap;
  }

</style>
