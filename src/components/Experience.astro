---
import { EXPERIENCES } from "../config/site";
---

<section id="experience" class="experience section">
  <header class="section-header">
    <h2 class="section-title">Where I've Worked</h2>
    <span class="section-line" aria-hidden="true"></span>
  </header>

  <div class="experience-list">
    {EXPERIENCES.map((exp) => (
      <article class="experience-item">
        <h3 class="role-line">
          {exp.role} <span class="at">@</span> <span class="company">{exp.company}</span>
        </h3>
        <p class="period mono">{exp.period}</p>
        <ul class="impact-list">
          {exp.impact.map((item) => (
            <li class="impact-item">{item}</li>
          ))}
        </ul>
        {exp.tags.length > 0 && (
          <div class="tags-row">
            {exp.tags.map((tag) => (
              <span class="exp-tag mono">{tag}</span>
            ))}
          </div>
        )}
      </article>
    ))}
  </div>
</section>

<style>
  .experience {
    padding-block: var(--space-16) var(--space-16);
  }

  .section-header {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    margin-bottom: var(--space-12);
  }

  .section-title {
    font-size: var(--text-h2);
    font-weight: 600;
    margin: 0;
    white-space: nowrap;
    color: var(--color-text-primary);
    letter-spacing: -0.02em;
  }

  .section-line {
    flex: 1;
    height: 1px;
    background-color: var(--color-border);
  }

  .experience-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
  }

  .experience-item {
    display: flex;
    flex-direction: column;
  }

  .role-line {
    font-size: var(--text-h3);
    font-weight: 600;
    color: var(--color-text-primary);
    margin: 0;
    line-height: 1.4;
    letter-spacing: -0.01em;
  }

  .at {
    color: var(--color-text-muted);
    font-weight: 400;
  }

  .company {
    color: var(--color-accent);
  }

  .period {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    margin: var(--space-1) 0 var(--space-6);
  }

  .impact-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .impact-item {
    font-size: var(--text-small);
    line-height: 1.65;
    color: var(--color-text-secondary);
    padding-left: var(--space-6);
    position: relative;
  }

  .impact-item::before {
    content: "▹";
    position: absolute;
    left: 0;
    top: 0;
    color: var(--color-accent);
    font-size: var(--text-xs);
    line-height: 1.85;
  }

  .tags-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-6);
  }

  .exp-tag {
    font-size: var(--text-xs);
    padding: 2px var(--space-2);
    background-color: rgba(96, 165, 250, 0.08);
    border: 1px solid rgba(96, 165, 250, 0.15);
    border-radius: 9999px;
    color: var(--color-accent);
    white-space: nowrap;
  }
</style>
