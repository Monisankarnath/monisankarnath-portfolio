---
interface Experience {
  company: string;
  role: string;
  period: string;
  impact: string[];
  tags: string[];
}

const experiences: Experience[] = [
  {
    company: "GeekyAnts",
    role: "Senior Software Engineer",
    period: "2021 – Present",
    impact: [
      "Shipped a vertical video streaming product — acquired 100+ paid users within 2 weeks of going live",
      "Led expo mobile architecture for fleet tracking apps used by 50k+ users",
      "Built auth and core modules for a cross-platform monorepo serving 10+ brands under an $11B enterprise",
      "Core contributor to Jio Design System across 500M+ download apps",
    ],
    tags: [
      "React Native",
      "Expo",
      "TypeScript",
      "Next.js",
      "Swift",
      "Nest.js",
      "Supabase",
    ],
  },
  {
    company: "Wipro",
    role: "Software Engineer",
    period: "2020 – 2021",
    impact: [
      "Worked as a HRMS technical Oracle EBS developer, building PL/SQL triggers and reports.",
    ],
    tags: ["SQL", "PL/SQL", "Oracle EBS", "Database"],
  },
];
---

<section id="experience" class="experience">
  <h2 class="sr-only">Experience</h2>
  <div class="experience-list">
    {
      experiences.map((exp) => (
        <div class="experience-item">
          <h3 class="role-line">
            {exp.role} <span class="at">@</span> <span class="company">{exp.company}</span>
          </h3>
          <span class="period mono">{exp.period}</span>
          <ul class="impact-list">
            {exp.impact.map((item) => (
              <li class="impact-item">{item}</li>
            ))}
          </ul>
          {exp.tags.length > 0 && (
            <div class="tags-row">
              {exp.tags.map((tag) => (
                <span class="exp-tag">{tag}</span>
              ))}
            </div>
          )}
        </div>
      ))
    }
  </div>
</section>

<style>
  .experience {
    padding-block: var(--space-6) var(--space-12);
  }

  .experience-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .experience-item {
    padding-bottom: var(--space-6);
  }

  .role-line {
    font-size: var(--text-body);
    font-weight: 500;
    color: var(--color-text-primary);
    margin: 0;
    line-height: 1.4;
  }

  .at {
    color: var(--color-text-muted);
    font-weight: 400;
  }

  .company {
    color: var(--color-text-secondary);
  }

  .period {
    display: block;
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    margin-top: var(--space-1);
    margin-bottom: var(--space-3);
  }

  .impact-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .impact-item {
    font-size: var(--text-small);
    line-height: 1.6;
    color: var(--color-text-muted);
    padding-left: var(--space-4);
    position: relative;
  }

  .impact-item::before {
    content: "▹";
    position: absolute;
    left: 0;
    color: var(--color-accent);
    font-size: var(--text-xs);
  }

  .tags-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-3);
  }

  .exp-tag {
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    padding: 2px var(--space-2);
    background-color: rgba(96, 165, 250, 0.08);
    border: 1px solid rgba(96, 165, 250, 0.15);
    border-radius: 9999px;
    color: var(--color-accent);
    white-space: nowrap;
  }
</style>
