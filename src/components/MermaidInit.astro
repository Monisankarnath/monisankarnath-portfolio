<script>
  let mermaidInitialized = false;

  function loadMermaid(): Promise<void> {
    return new Promise((resolve, reject) => {
      if ((window as any).mermaid) {
        resolve();
        return;
      }
      const script = document.createElement('script');
      script.src =
        'https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.min.js';
      script.onload = () => resolve();
      script.onerror = reject;
      document.head.appendChild(script);
    });
  }

  async function initMermaid() {
    const blocks = document.querySelectorAll('pre.mermaid');
    if (blocks.length === 0) return;

    await loadMermaid();
    const mermaid = (window as any).mermaid;

    if (!mermaidInitialized) {
      await document.fonts.ready;

      mermaid.initialize({
        startOnLoad: false,
        theme: 'base',
        fontFamily: 'Geist Mono, monospace',
        fontSize: 16,
        flowchart: {
          htmlLabels: false,
          useMaxWidth: true,
        },
        themeVariables: (() => {
          const css = getComputedStyle(document.documentElement);
          const tok = (n: string) => css.getPropertyValue(n).trim();
          const hex = (h: string) => [1, 3, 5].map((i) => parseInt(h.slice(i, i + 2), 16));
          const mix = (a: string, b: string, t: number) =>
            '#' + hex(a).map((v, i) => Math.round(v * t + hex(b)[i] * (1 - t)).toString(16).padStart(2, '0')).join('');
          const bg = tok('--color-bg-primary');
          const surface = tok('--color-bg-surface');
          const elevated = tok('--color-bg-elevated');
          const text = tok('--color-text-primary');
          const soft = tok('--color-text-secondary');
          const line = mix(text, bg, 0.28);
          const edge = tok('--color-text-muted');
          return {
            background: bg,
            primaryColor: surface, primaryTextColor: text, primaryBorderColor: line,
            secondaryColor: elevated, secondaryTextColor: text, secondaryBorderColor: line,
            tertiaryColor: elevated, tertiaryTextColor: soft, tertiaryBorderColor: line,
            lineColor: edge, textColor: text,
            noteBkgColor: elevated, noteTextColor: text, noteBorderColor: line,
            clusterBkg: surface, clusterBorder: line,
            edgeLabelBackground: bg,
            actorBkg: surface, actorBorder: line, actorTextColor: text,
            activationBorderColor: edge, activationBkgColor: elevated,
            signalColor: text,
            labelBoxBkgColor: surface, labelBoxBorderColor: line, labelTextColor: text,
            loopTextColor: soft,
          };
        })(),
      });

      mermaidInitialized = true;
    }

    await mermaid.run({ nodes: blocks });
    document.dispatchEvent(new CustomEvent('mermaid:rendered'));
  }

  document.addEventListener('astro:page-load', initMermaid);
  initMermaid();
</script>
