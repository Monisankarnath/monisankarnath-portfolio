<script>
  let mermaidInitialized = false;

  function loadMermaid(): Promise<void> {
    return new Promise((resolve, reject) => {
      if ((window as any).mermaid) {
        resolve();
        return;
      }
      const script = document.createElement('script');
      script.src =
        'https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.min.js';
      script.onload = () => resolve();
      script.onerror = reject;
      document.head.appendChild(script);
    });
  }

  async function initMermaid() {
    const blocks = document.querySelectorAll('pre.mermaid');
    if (blocks.length === 0) return;

    await loadMermaid();
    const mermaid = (window as any).mermaid;

    if (!mermaidInitialized) {
      await document.fonts.ready;

      mermaid.initialize({
        startOnLoad: false,
        theme: 'base',
        fontFamily: 'Geist Mono, monospace',
        fontSize: 16,
        flowchart: {
          htmlLabels: true,
          useMaxWidth: true,
        },
        themeVariables: {
          background: '#0E1116',

          primaryColor: '#1c2533',
          primaryTextColor: '#e6edf3',
          primaryBorderColor: '#4a5568',

          secondaryColor: '#1e2a3a',
          secondaryTextColor: '#e6edf3',
          secondaryBorderColor: '#4a5568',

          tertiaryColor: '#1e2a3a',
          tertiaryTextColor: '#9ca3af',
          tertiaryBorderColor: '#4a5568',

          lineColor: '#6b7280',
          textColor: '#e6edf3',

          noteBkgColor: '#1e2a3a',
          noteTextColor: '#e6edf3',
          noteBorderColor: '#4a5568',

          clusterBkg: '#1c2533',
          clusterBorder: '#4a5568',

          edgeLabelBackground: '#0E1116',

          actorBkg: '#1c2533',
          actorBorder: '#4a5568',
          actorTextColor: '#e6edf3',
          activationBorderColor: '#6b7280',
          activationBkgColor: '#1e2a3a',
          signalColor: '#e6edf3',
          labelBoxBkgColor: '#1c2533',
          labelBoxBorderColor: '#4a5568',
          labelTextColor: '#e6edf3',
          loopTextColor: '#9ca3af',
        },
      });

      mermaidInitialized = true;
    }

    await mermaid.run({ nodes: blocks });
  }

  document.addEventListener('astro:page-load', initMermaid);
  initMermaid();
</script>
