---
import { getCollection } from "astro:content";
import { CONTACT, MAILTO, RESUME, PROJECTS } from "../config/site";

interface SearchItem {
  title: string;
  description: string;
  href: string;
  type: "page" | "blog" | "case-study" | "external";
  tags?: string[];
  isDefault?: boolean;
}

const defaultPages: SearchItem[] = [
  { title: "Home", description: "Go to homepage", href: "/", type: "page", isDefault: true },
  { title: "Blog", description: "Technical writing", href: "/blog", type: "page", isDefault: true },
  { title: "Case Studies", description: "Deep dives into systems", href: "/case-studies", type: "page", isDefault: true },
  { title: "Open Source", description: "Libraries and tools", href: "/open-source", type: "page", isDefault: true },
];

const hiddenPages: SearchItem[] = [
  { title: "Support", description: "Support open source", href: "/support", type: "page" },
];

const externalLinks: SearchItem[] = [
  { title: "GitHub", description: CONTACT.github.handle, href: CONTACT.github.url, type: "external" },
  { title: "YouTube", description: CONTACT.youtube.handle, href: CONTACT.youtube.url, type: "external" },
  { title: "LinkedIn", description: CONTACT.linkedin.handle, href: CONTACT.linkedin.url, type: "external" },
  { title: "Email", description: CONTACT.email, href: MAILTO, type: "external" },
  { title: "Resume", description: "View resume PDF", href: RESUME.path, type: "external" },
  { title: "expo-video-cache", description: "npm package", href: PROJECTS.expoVideoCache.npm, type: "external", tags: ["npm", "open source", "expo", "video", "cache"] },
];

const blogPosts = await getCollection("blog", ({ data }) => !data.draft);
const blogItems: SearchItem[] = blogPosts
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime())
  .map((post) => ({
    title: post.data.title,
    description: "Blog",
    href: `/blog/${post.slug}`,
    type: "blog" as const,
    tags: post.data.tags,
  }));

const caseStudies = await getCollection("case-studies");
const caseStudyItems: SearchItem[] = caseStudies
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime())
  .map((study) => ({
    title: study.data.title,
    description: "Case Study",
    href: `/case-studies/${study.slug}`,
    type: "case-study" as const,
    tags: study.data.tags,
  }));

const allItems: SearchItem[] = [
  ...defaultPages,
  ...hiddenPages,
  ...blogItems,
  ...caseStudyItems,
  ...externalLinks,
];
---

<dialog id="command-palette" class="palette">
  <div class="palette-content">
    <div class="search-wrapper">
      <svg class="search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="8"/>
        <path d="m21 21-4.3-4.3"/>
      </svg>
      <input
        type="text"
        id="command-input"
        class="search-input mono"
        placeholder="Search..."
        autocomplete="off"
      />
      <kbd class="escape-hint">ESC</kbd>
    </div>

    <ul id="command-results" class="results"></ul>

    <div id="no-results" class="no-results text-muted" style="display: none;">
      No results found
    </div>
  </div>
</dialog>

<script is:inline define:vars={{ allItems, defaultPages }}>
  window.__cmdAllItems = allItems;
  window.__cmdDefaults = defaultPages;
</script>

<script>
  let cmdAbortController: AbortController | null = null;

  function initCommandPalette() {
    if (cmdAbortController) cmdAbortController.abort();
    cmdAbortController = new AbortController();
    const { signal } = cmdAbortController;

    const dialog = document.getElementById("command-palette") as HTMLDialogElement;
    const input = document.getElementById("command-input") as HTMLInputElement;
    const resultsList = document.getElementById("command-results") as HTMLUListElement;
    const noResults = document.getElementById("no-results") as HTMLDivElement;

    if (!dialog || !input || !resultsList || !noResults) return;

    const allItems = (window as any).__cmdAllItems as any[];
    const defaultPages = (window as any).__cmdDefaults as any[];

    let currentIndex = 0;

    function matchesQuery(item: any, words: string[]): boolean {
      const searchable = [
        item.title,
        item.description,
        item.type,
        ...(item.tags || []),
      ]
        .join(" ")
        .toLowerCase();

      return words.every((w) => searchable.includes(w));
    }

    function getResults(query: string): any[] {
      if (!query.trim()) return defaultPages;

      const words = query.toLowerCase().split(/\s+/).filter(Boolean);
      return allItems.filter((item) => matchesQuery(item, words));
    }

    function renderResults(items: any[]) {
      resultsList.innerHTML = "";

      if (items.length === 0) {
        noResults.style.display = "block";
        return;
      }

      noResults.style.display = "none";

      items.forEach((item, i) => {
        const li = document.createElement("li");
        const a = document.createElement("a");
        a.href = item.href;
        a.className = "result-item" + (i === 0 ? " selected" : "");
        a.setAttribute("data-index", String(i));

        if (item.type === "external") {
          a.setAttribute("target", "_blank");
          a.setAttribute("rel", "noopener noreferrer");
        }

        const titleSpan = document.createElement("span");
        titleSpan.className = "result-title";
        titleSpan.textContent = item.title;

        const descSpan = document.createElement("span");
        descSpan.className = "result-desc text-muted";
        descSpan.textContent = item.type === "external" ? item.description + " ↗" : item.description;

        a.appendChild(titleSpan);
        a.appendChild(descSpan);
        li.appendChild(a);
        resultsList.appendChild(li);
      });

      currentIndex = 0;
    }

    function updateSelection(index: number) {
      const items = resultsList.querySelectorAll(".result-item");
      items.forEach((el) => el.classList.remove("selected"));
      currentIndex = Math.max(0, Math.min(index, items.length - 1));
      if (items[currentIndex]) {
        items[currentIndex].classList.add("selected");
        items[currentIndex].scrollIntoView({ block: "nearest" });
      }
    }

    function handleNavigate() {
      const items = resultsList.querySelectorAll(".result-item");
      const selected = items[currentIndex] as HTMLAnchorElement;
      if (!selected) return;

      dialog.close();
      selected.click();
    }

    function openPalette() {
      dialog.showModal();
      input.focus();
      input.value = "";
      renderResults(defaultPages);
    }

    document.addEventListener("keydown", (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key === "k") {
        e.preventDefault();
        openPalette();
      }
    }, { signal });

    document.addEventListener("open-command-palette", openPalette, { signal });

    dialog.addEventListener("click", (e) => {
      if (e.target === dialog) dialog.close();
    }, { signal });

    dialog.addEventListener("close", () => {
      input.value = "";
    }, { signal });

    input.addEventListener("input", () => {
      const results = getResults(input.value);
      renderResults(results);
    }, { signal });

    input.addEventListener("keydown", (e) => {
      const count = resultsList.querySelectorAll(".result-item").length;

      if (e.key === "ArrowDown") {
        e.preventDefault();
        updateSelection(Math.min(currentIndex + 1, count - 1));
      } else if (e.key === "ArrowUp") {
        e.preventDefault();
        updateSelection(Math.max(currentIndex - 1, 0));
      } else if (e.key === "Enter") {
        e.preventDefault();
        handleNavigate();
      }
    }, { signal });

    resultsList.addEventListener("click", (e) => {
      const item = (e.target as HTMLElement).closest(".result-item") as HTMLAnchorElement;
      if (!item) return;

      dialog.close();
    }, { signal });
  }

  document.addEventListener('astro:page-load', initCommandPalette);
  initCommandPalette();
</script>

<style>
  .palette {
    position: fixed;
    top: 20%;
    left: 50%;
    transform: translateX(-50%);
    width: 90%;
    max-width: 560px;
    padding: 0;
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    background-color: var(--color-bg-surface);
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
  }

  .palette::backdrop {
    background-color: rgba(0, 0, 0, 0.7);
    backdrop-filter: blur(4px);
  }

  .palette-content {
    display: flex;
    flex-direction: column;
    max-height: 400px;
  }

  .search-wrapper {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-4);
    border-bottom: 1px solid var(--color-border);
  }

  .search-icon {
    color: var(--color-text-muted);
    flex-shrink: 0;
  }

  .search-input {
    flex: 1;
    background: none;
    border: none;
    color: var(--color-text-primary);
    font-size: var(--text-body);
    outline: none;
  }

  .search-input::placeholder {
    color: var(--color-text-muted);
  }

  .escape-hint {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    background-color: var(--color-bg-primary);
    padding: var(--space-1) var(--space-2);
    border-radius: 4px;
    border: 1px solid var(--color-border);
  }

  .no-results {
    padding: var(--space-8);
    text-align: center;
    font-size: var(--text-small);
  }
</style>

<style is:global>
  #command-results {
    list-style: none;
    padding: var(--space-2);
    margin: 0;
    overflow-y: auto;
    flex: 1;
  }

  #command-results .result-item {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-6);
    padding: var(--space-3) var(--space-4);
    border-radius: 0.5rem;
    text-decoration: none;
    transition: background-color var(--transition-fast);
  }

  #command-results .result-item:hover,
  #command-results .result-item.selected {
    background-color: var(--color-bg-elevated);
  }

  #command-results .result-title {
    font-size: var(--text-body);
    color: var(--color-text-primary);
    min-width: 0;
  }

  #command-results .result-desc {
    font-size: var(--text-small);
    color: var(--color-text-muted);
    white-space: nowrap;
    flex-shrink: 0;
  }
</style>
