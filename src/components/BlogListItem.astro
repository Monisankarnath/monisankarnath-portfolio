---
interface Props {
  title: string;
  slug: string;
  publishedAt: Date;
  hook?: string;
  readTime?: string;
}

const { title, slug, publishedAt, hook, readTime } = Astro.props;

const formatDate = (date: Date) => {
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  });
};
---

<li class="post-item">
  <a href={`/blog/${slug}`} class="post-link">
    <div class="post-content">
      <div class="title-row">
        <h2 class="post-title">{title}</h2>
        <time class="post-date mono text-muted" datetime={publishedAt.toISOString()}>
          {formatDate(publishedAt)}
        </time>
      </div>

      <div class="meta-row">
        {hook && <p class="post-hook text-muted">{hook}</p>}
      </div>
    </div>

    <span class="post-arrow" aria-hidden="true">→</span>
  </a>
</li>

<style>
  .post-item {
    border-bottom: 1px solid var(--color-border);
  }

  .post-link {
    display: flex;
    align-items: flex-start;
    gap: var(--space-6);
    padding: var(--space-6) var(--space-4);
    text-decoration: none;
    transition: background-color var(--transition-fast);
  }

  .post-link:hover {
    background-color: var(--color-bg-surface);
  }

  .post-content {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .title-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .post-title {
    font-size: var(--text-h3);
    font-weight: 600;
    margin: 0;
    color: var(--color-text-primary);
    line-height: 1.4;
  }

  .post-date {
    font-size: var(--text-xs);
    white-space: nowrap;
    flex-shrink: 0;
  }

  .meta-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .post-hook {
    font-size: var(--text-small);
    margin: 0;
    line-height: 1.4;
    font-style: italic;
  }

  .read-time {
    font-size: var(--text-xs);
    white-space: nowrap;
    flex-shrink: 0;
  }

  .post-arrow {
    flex-shrink: 0;
    font-size: var(--text-body);
    color: var(--color-text-muted);
    margin-top: var(--space-1);
    transition: transform var(--transition-fast), color var(--transition-fast);
  }

  .post-link:hover .post-arrow {
    transform: translateX(3px);
    color: var(--color-accent);
  }

  @media (max-width: 640px) {
    .post-link {
      padding: var(--space-6) var(--space-2);
    }

    .title-row {
      flex-direction: column;
      gap: var(--space-1);
    }

    .post-date {
      order: -1;
    }

    .post-title {
      font-size: var(--text-body);
    }

    .meta-row {
      flex-direction: column;
      gap: var(--space-1);
    }
  }
</style>
