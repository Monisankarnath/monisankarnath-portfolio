---
interface Props {
  title: string;
  description: string;
  slug: string;
  publishedAt: Date;
  readTime?: string;
}

const { title, description, slug, publishedAt, readTime } = Astro.props;

const formatDate = (date: Date) => {
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  });
};
---

<li class="post-item">
  <a href={`/blog/${slug}`} class="post-link">
    <div class="post-content">
      <h2 class="post-title">{title}</h2>
      <p class="post-description text-secondary">
        {description}
      </p>
      {readTime && <span class="read-time text-muted mono">{readTime}</span>}
    </div>
    <time class="post-date mono text-muted" datetime={publishedAt.toISOString()}>
      {formatDate(publishedAt)}
    </time>
  </a>
</li>

<style>
  .post-item {
    border-bottom: 1px solid var(--color-border);
  }
  
  .post-link {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-6);
    padding: var(--space-6) 0;
    text-decoration: none;
    transition: background-color var(--transition-fast);
  }
  
  .post-link:hover {
    background-color: var(--color-bg-surface);
    margin-inline: calc(var(--space-4) * -1);
    padding-inline: var(--space-4);
  }
  
  .post-content {
    flex: 1;
    min-width: 0;
  }
  
  .post-title {
    font-size: var(--text-h3);
    font-weight: 600;
    margin-bottom: var(--space-1);
    color: var(--color-text-primary);
  }
  
  .post-description {
    font-size: var(--text-small);
    line-height: 1.5;
    margin: 0 0 var(--space-2);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  
  .read-time {
    font-size: var(--text-xs);
  }
  
  .post-date {
    font-size: var(--text-xs);
    white-space: nowrap;
    flex-shrink: 0;
    margin-top: var(--space-1);
  }
  
  @media (max-width: 640px) {
    .post-link {
      flex-direction: column;
      gap: var(--space-2);
    }
    
    .post-date {
      order: -1;
      margin-top: 0;
    }
  }
</style>
