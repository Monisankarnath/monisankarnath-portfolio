---
interface Props {
  name: string;
  tagline: string;
  npmUrl?: string;
  spiUrl?: string;
  githubUrl: string;
  tech: readonly string[];
  stats?: {
    downloads?: string;
    stars?: string;
    lastUpdated?: string;
  };
}

const { name, tagline, npmUrl, spiUrl, githubUrl, tech, stats } = Astro.props;
---

<div class="oss-card">
  <div class="card-top">
    <h2 class="card-name">{name}</h2>
    <div class="card-links">
      {npmUrl && (
        <a href={npmUrl} class="card-link mono" target="_blank" rel="noopener noreferrer">
          npm ↗
        </a>
      )}
      {spiUrl && (
        <a href={spiUrl} class="card-link mono" target="_blank" rel="noopener noreferrer">
          SPI ↗
        </a>
      )}
      <a href={githubUrl} class="card-link mono" target="_blank" rel="noopener noreferrer">
        GitHub ↗
      </a>
    </div>
  </div>

  <p class="card-tagline">{tagline}</p>

  {tech.length > 0 && (
    <div class="tech-row">
      {tech.map((t) => (
        <span class="tech-pill mono">{t}</span>
      ))}
    </div>
  )}

  {stats && (
    <div class="stats-row">
      {stats.downloads && (
        <span class="stat"><strong>{stats.downloads}</strong> downloads</span>
      )}
      {stats.stars && (
        <span class="stat"><strong>{stats.stars}</strong> stars</span>
      )}
      {stats.lastUpdated && (
        <span class="stat">Updated <strong>{stats.lastUpdated}</strong></span>
      )}
    </div>
  )}
</div>

<style>
  .oss-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-6);
    background-color: var(--color-bg-surface);
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    transition: border-color var(--transition-fast);
  }

  .oss-card:hover {
    border-color: rgba(255, 255, 255, 0.08);
  }

  .card-top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .card-name {
    font-size: var(--text-h2);
    font-weight: 700;
    margin: 0;
    color: var(--color-text-primary);
    letter-spacing: -0.02em;
  }

  .card-links {
    display: flex;
    gap: var(--space-3);
    flex-shrink: 0;
  }

  .card-link {
    font-size: var(--text-small);
    color: var(--color-accent);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .card-link:hover {
    color: var(--color-text-primary);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .card-tagline {
    font-size: var(--text-body);
    color: var(--color-text-secondary);
    margin: 0;
    line-height: 1.5;
  }

  .tech-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .tech-pill {
    font-size: var(--text-xs);
    padding: 2px var(--space-2);
    background-color: rgba(96, 165, 250, 0.08);
    border: 1px solid rgba(96, 165, 250, 0.15);
    border-radius: 9999px;
    color: var(--color-accent);
    white-space: nowrap;
  }

  .stats-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-6);
    font-size: var(--text-small);
    color: var(--color-text-muted);
  }

  .stats-row strong {
    color: var(--color-text-primary);
    font-weight: 600;
  }

  @media (max-width: 640px) {
    .card-top {
      flex-direction: column;
      gap: var(--space-2);
    }

    .card-name {
      font-size: var(--text-h3);
    }
  }
</style>
