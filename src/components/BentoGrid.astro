---
import { getCollection } from "astro:content";
import { PROJECTS } from "../config/site";

const allCaseStudies = await getCollection("case-studies");
const allBlogs = (await getCollection("blog")).filter((post) => !post.data.draft);
const openSourceCount = Object.keys(PROJECTS).length;

interface GridItem {
  title: string;
  subtitle: string;
  count: string;
  href: string;
  accentColor: string;
  accentBg: string;
}

const items: GridItem[] = [
  {
    title: 'Case Studies',
    subtitle: 'Deep dives into real systems — architecture decisions, tradeoffs, and results.',
    count: `${allCaseStudies.length} ${allCaseStudies.length === 1 ? 'study' : 'studies'}`,
    href: '/case-studies',
    accentColor: 'var(--color-accent)',
    accentBg: 'color-mix(in srgb, var(--color-accent) 8%, transparent)',
  },
  {
    title: 'Open Source',
    subtitle: 'Libraries and tools I build, maintain, and ship to production.',
    count: `${openSourceCount} ${openSourceCount === 1 ? 'project' : 'projects'}`,
    href: '/open-source',
    accentColor: '#34D399',
    accentBg: 'rgba(52, 211, 153, 0.08)',
  },
  {
    title: 'Writing',
    subtitle: 'Technical blogs on performance, architecture, and engineering craft.',
    count: `${allBlogs.length} ${allBlogs.length === 1 ? 'post' : 'posts'}`,
    href: '/blog',
    accentColor: '#A78BFA',
    accentBg: 'rgba(167, 139, 250, 0.08)',
  },
];
---

<section id="writing" class="bento section">
  <div class="bento-grid">
    {items.map((item) => (
      <a
        href={item.href}
        class="bento-card"
        style={`--accent: ${item.accentColor}; --accent-bg: ${item.accentBg}`}
      >
        <h3 class="card-title">{item.title}</h3>
        <p class="card-subtitle">{item.subtitle}</p>
        <div class="card-footer">
          <span class="card-count mono">{item.count}</span>
        </div>
      </a>
    ))}
  </div>
</section>

<style>
  .bento {
    padding-block: var(--space-12);
  }

  .bento-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  @media (min-width: 640px) {
    .bento-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .bento-card {
    display: flex;
    flex-direction: column;
    padding: var(--space-6);
    text-decoration: none;
    border-radius: 0.75rem;
    background-color: var(--color-bg-surface);
    transition: transform var(--transition-fast), background-color var(--transition-fast);
  }

  .bento-card:hover {
    transform: translateY(-3px);
    background-color: var(--color-bg-elevated);
  }

  @media (prefers-reduced-motion: reduce) {
    .bento-card {
      transition: none;
    }
    .bento-card:hover {
      transform: none;
    }
  }

  .card-title {
    font-size: var(--text-h3);
    font-weight: 600;
    margin-bottom: var(--space-2);
    color: var(--color-text-primary);
  }

  .card-subtitle {
    font-size: var(--text-small);
    color: var(--color-text-secondary);
    margin: 0;
    line-height: 1.5;
    flex-grow: 1;
  }

  .card-footer {
    display: flex;
    align-items: center;
    margin-top: var(--space-4);
  }

  .card-count {
    font-size: var(--text-xs);
    color: var(--accent);
    background: var(--accent-bg);
    padding: var(--space-1) var(--space-2);
    border-radius: 4px;
  }
</style>
