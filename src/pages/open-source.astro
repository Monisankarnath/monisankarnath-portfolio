---
import Layout from "../layouts/Layout.astro";
import OpenSourceCard from "../components/OpenSourceCard.astro";
import { SITE, PROJECTS } from "../config/site";

const projects = Object.values(PROJECTS);
---

<Layout
  title={`Open Source | ${SITE.name} – ${SITE.title}`}
  description={`${SITE.name}, ${SITE.title}, maintains open source libraries for React Native and JavaScript ecosystems to help developers build better apps.`}
>
  <div class="container">
    <article class="open-source">
      <a href="/" class="back-link">← Home</a>

      <h1>Open Source</h1>

      <p class="intro text-secondary">
        Libraries and tools I build and maintain.
      </p>

      <div class="projects">
        {projects.map((project) => (
          <OpenSourceCard
            name={project.name}
            tagline={project.tagline}
            npmUrl={"npm" in project ? project.npm : undefined}
            spiUrl={"spi" in project ? project.spi : undefined}
            githubUrl={project.github}
            tech={project.tech}
            stats={"stats" in project ? project.stats : undefined}
          />
        ))}
      </div>

      <p class="support-cta text-muted">
        Want to support this work? <a href="/support">Support open source →</a>
      </p>
    </article>
  </div>
</Layout>

<style>
  .open-source {
    padding-block: var(--space-12) var(--space-16);
  }

  .back-link {
    display: inline-block;
    font-size: var(--text-small);
    color: var(--color-text-muted);
    margin-bottom: var(--space-8);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .back-link:hover {
    color: var(--color-text-primary);
  }

  h1 {
    font-size: var(--text-h1);
    margin-bottom: var(--space-3);
  }

  .intro {
    font-size: var(--text-body);
    margin-bottom: var(--space-12);
  }

  .projects {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .support-cta {
    font-size: var(--text-small);
    margin-top: var(--space-16);
  }

  .support-cta a {
    color: var(--color-accent);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .support-cta a:hover {
    color: var(--color-text-primary);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
