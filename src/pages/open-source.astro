---
import Layout from "../layouts/Layout.astro";
import OpenSourceCard from "../components/OpenSourceCard.astro";
import { SITE, PROJECTS } from "../config/site";
---

<Layout
  title={`Open Source | ${SITE.name} – ${SITE.title}`}
  description={`${SITE.name}, ${SITE.title}, maintains open source libraries for React Native and JavaScript ecosystems to help developers build better apps.`}
>
  <div class="container">
    <article class="open-source section">
      <a href="/" class="back-link">← Home</a>

      <h1>Open Source</h1>

      <p class="intro text-secondary">
        Libraries and tools I maintain for the community.
      </p>

      <div class="projects">
        <OpenSourceCard
          name={PROJECTS.expoVideoCache.name}
          description={PROJECTS.expoVideoCache.description}
          npmUrl={PROJECTS.expoVideoCache.npm}
          githubUrl={PROJECTS.expoVideoCache.github}
          stats={{
            downloads: "500/month",
            stars: "3",
            lastUpdated: "Feb 2026",
          }}
        />
      </div>

      <div class="contribute">
        <h2>Contributing</h2>
        <p class="text-secondary">
          Found a bug or have a feature idea? Open an issue on GitHub. Pull
          requests are welcome for bug fixes and improvements.
        </p>
      </div>
    </article>
  </div>
</Layout>

<style>
  .open-source {
    padding-block: var(--space-12);
  }

  .back-link {
    display: inline-block;
    font-size: var(--text-small);
    color: var(--color-text-muted);
    margin-bottom: var(--space-8);
    transition: color var(--transition-fast);
  }

  .back-link:hover {
    color: var(--color-text-primary);
  }

  h1 {
    font-size: var(--text-h1);
    margin-bottom: var(--space-4);
  }

  .intro {
    font-size: var(--text-body);
    margin-bottom: var(--space-8);
  }

  .projects {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .contribute {
    margin-top: var(--space-16);
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-border);
  }

  .contribute h2 {
    font-size: var(--text-h2);
    margin-bottom: var(--space-4);
  }

  .contribute p {
    max-width: var(--content-width);
    line-height: 1.6;
  }
</style>
