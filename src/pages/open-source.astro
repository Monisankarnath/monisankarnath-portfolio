---
import Layout from "../layouts/Layout.astro";
import OpenSourceCard from "../components/OpenSourceCard.astro";
import { SITE, PROJECTS } from "../config/site";
---

<Layout
  title={`Open Source | ${SITE.name} – ${SITE.title}`}
  description={`${SITE.name}, ${SITE.title}, maintains open source libraries for React Native and JavaScript ecosystems to help developers build better apps.`}
>
  <div class="container">
    <article class="open-source section">
      <a href="/" class="back-link">← Home</a>

      <h1>Open Source</h1>

      <p class="intro text-secondary">
        Libraries and tools I maintain for the community.
      </p>

      <div class="projects">
        <OpenSourceCard
          name={PROJECTS.expoVideoCache.name}
          tagline={PROJECTS.expoVideoCache.tagline}
          npmUrl={PROJECTS.expoVideoCache.npm}
          githubUrl={PROJECTS.expoVideoCache.github}
          tech={PROJECTS.expoVideoCache.tech}
          stats={{
            downloads: "500+",
            stars: "3",
            lastUpdated: "Feb 2026",
          }}
        />
      </div>
    </article>
  </div>
</Layout>

<style>
  .open-source {
    padding-block: var(--space-12);
  }

  .back-link {
    display: inline-block;
    font-size: var(--text-small);
    color: var(--color-text-muted);
    margin-bottom: var(--space-8);
    transition: color var(--transition-fast);
  }

  .back-link:hover {
    color: var(--color-text-primary);
  }

  h1 {
    font-size: var(--text-h1);
    margin-bottom: var(--space-4);
  }

  .intro {
    font-size: var(--text-body);
    margin-bottom: var(--space-8);
    border-bottom: 1px solid var(--color-border);
    padding-bottom: var(--space-8);
  }

  .projects {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }
</style>
