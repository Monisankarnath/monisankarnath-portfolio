---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import Experience from "../components/Experience.astro";
import HowIWork from "../components/HowIWork.astro";
import BentoGrid from "../components/BentoGrid.astro";
import Projects from "../components/Projects.astro";
import { SEO, SITE, CONTACT, MAILTO } from "../config/site";

const currentYear = new Date().getFullYear();
---

<Layout
  title={SEO.defaultTitle}
  description={SEO.defaultDescription}
>
  <div class="container">
    <Hero />
    <div class="section-animate"><Experience /></div>
    <div class="section-animate"><HowIWork /></div>
    <div class="section-animate"><BentoGrid /></div>
    <div class="section-animate"><Projects /></div>

    <div class="section-animate">
      <footer class="end-note">
        <p class="end-text text-muted">
          You scrolled past my entire life story. Least you can do is <a href={MAILTO}>say hi</a>.
        </p>
        <p class="end-copy text-muted mono">
          © {currentYear} {SITE.name}
        </p>
      </footer>
    </div>
  </div>
</Layout>

<script>
  let isTraversal = false;
  document.addEventListener('astro:before-swap', ((e: any) => {
    isTraversal = e.navigationType === 'traverse';
  }) as EventListener);

  document.addEventListener('astro:page-load', () => {
    const sections = document.querySelectorAll('.section-animate');
    if (!sections.length) return;

    if (isTraversal) {
      isTraversal = false;
      sections.forEach((el) => el.classList.add('visible'));
      const hash = window.location.hash.substring(1);
      if (hash) {
        const target = document.getElementById(hash);
        if (target) {
          requestAnimationFrame(() => target.scrollIntoView());
        }
      }
    } else {
      sections.forEach((el) => el.classList.remove('visible'));

      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('visible');
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.1 }
        );

        sections.forEach((el) => observer.observe(el));
      } else {
        sections.forEach((el) => el.classList.add('visible'));
      }
    }

    const hashSections = document.querySelectorAll('section[id]');
    if (!hashSections.length) return;

    const hashObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const id = entry.target.getAttribute('id');
            if (id === 'top') {
              history.replaceState(history.state, '', '/');
              sessionStorage.removeItem('home-section');
            } else if (id) {
              history.replaceState(history.state, '', `/#${id}`);
              sessionStorage.setItem('home-section', id);
            }
          }
        });
      },
      { rootMargin: '-20% 0px -70% 0px' }
    );

    hashSections.forEach((section) => hashObserver.observe(section));
  });
</script>

<style>
  .end-note {
    padding-block: var(--space-16) var(--space-12);
    text-align: center;
  }

  .end-text {
    font-size: var(--text-body);
    margin-bottom: var(--space-4);
  }

  .end-text a {
    color: var(--color-text-secondary);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
    transition: color var(--transition-fast);
  }

  .end-text a:hover {
    color: var(--color-text-primary);
  }

  .end-copy {
    font-size: var(--text-xs);
  }
</style>

<style is:global>
  .section-animate {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.7s ease-out, transform 0.7s ease-out;
  }

  .section-animate.visible {
    opacity: 1;
    transform: translateY(0);
  }
</style>
