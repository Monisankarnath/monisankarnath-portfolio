---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import Experience from "../components/Experience.astro";
import BentoGrid from "../components/BentoGrid.astro";
import Projects from "../components/Projects.astro";
import Awards from "../components/Awards.astro";
import { SEO, SITE, MAILTO } from "../config/site";

const currentYear = new Date().getFullYear();
---

<Layout
  title={SEO.defaultTitle}
  description={SEO.defaultDescription}
>
  <div class="container">
    <Hero />
    <Experience />
    <div class="section-animate"><BentoGrid /></div>
    <div class="section-animate"><Projects /></div>
    <div class="section-animate"><Awards /></div>

    <div class="section-animate">
      <footer class="end-note">
        <div class="end-line" aria-hidden="true"></div>
        <p class="end-text text-muted">
          You scrolled past my entire life story. Least you can do is <a href={MAILTO}>say hi</a>.
        </p>
        <p class="end-copy text-muted mono">
          © {currentYear} {SITE.name}
        </p>
      </footer>
    </div>
  </div>
</Layout>

<style>
  .end-note {
    padding-block: var(--space-16) var(--space-12);
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .end-line {
    width: 48px;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--color-accent), transparent);
    margin: 0 auto var(--space-8);
    opacity: 0.4;
  }

  .end-text {
    font-size: var(--text-body);
    margin-bottom: var(--space-4);
  }

  .end-text a {
    color: var(--color-text-secondary);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
    transition: color var(--transition-fast);
  }

  .end-text a:hover {
    color: var(--color-text-primary);
  }

  .end-copy {
    font-size: var(--text-xs);
  }
</style>

<style is:global>
  .section-animate {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.8s ease-out, transform 0.8s ease-out;
    animation: section-fallback 0.8s 1.5s forwards;
  }

  .section-animate.visible {
    opacity: 1;
    transform: translateY(0);
    animation: none;
  }

  @keyframes section-fallback {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .section-animate {
      opacity: 1;
      transform: none;
      animation: none;
    }
  }
</style>
