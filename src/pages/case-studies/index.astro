---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import CaseStudyCard from '../../components/CaseStudyCard.astro';
import { SITE } from '../../config/site';

const caseStudies = await getCollection('case-studies');

// Sort by date, newest first
const sortedStudies = caseStudies.sort((a, b) =>
  b.data.publishedAt.getTime() - a.data.publishedAt.getTime()
);
---

<Layout 
  title={`Case Studies — ${SITE.name}`}
  description="Deep dives into systems I've built — problems, decisions, and outcomes."
>
  <div class="container">
    <header class="page-header section">
      <a href="/" class="back-link">← Home</a>
      <h1>Case Studies</h1>
      <p class="lead text-secondary">
        Deep dives into systems I've built — problems, decisions, and outcomes.
      </p>
    </header>
    
    {sortedStudies.length === 0 ? (
      <div class="empty-state">
        <p class="text-muted">Case studies coming soon.</p>
      </div>
    ) : (
      <ul class="case-studies-list">
        {sortedStudies.map((study) => (
          <CaseStudyCard 
            title={study.data.title}
            slug={study.slug}
            publishedAt={study.data.publishedAt}
            metrics={study.data.metrics}
            tags={study.data.tags}
          />
        ))}
      </ul>
    )}
  </div>
</Layout>

<style>
  .page-header {
    padding-bottom: var(--space-8);
    border-bottom: 1px solid var(--color-border);
  }
  
  .back-link {
    display: inline-block;
    font-size: var(--text-small);
    color: var(--color-text-muted);
    margin-bottom: var(--space-6);
    transition: color var(--transition-fast);
  }
  
  .back-link:hover {
    color: var(--color-text-primary);
  }
  
  .page-header h1 {
    font-size: var(--text-h1);
    margin-bottom: var(--space-2);
  }
  
  .lead {
    font-size: var(--text-body);
    margin: 0;
  }
  
  .empty-state {
    padding: var(--space-16) 0;
    text-align: center;
  }
  
  .case-studies-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
</style>
