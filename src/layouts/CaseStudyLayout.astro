---
import Layout from "./Layout.astro";
import ContentNavigation from "../components/ContentNavigation.astro";
import type { MarkdownHeading } from "astro";
import { getCollection } from "astro:content";
import { SITE } from "../config/site";

interface Props {
  frontmatter: {
    title: string;
    description: string;
    publishedAt: Date;
    teamSize?: string;
    metrics: string[];
    tags: string[];
  };
  headings: MarkdownHeading[];
}

const { frontmatter, headings = [] } = Astro.props;
const formattedDate = frontmatter.publishedAt.toLocaleDateString("en-US", {
  month: "short",
  year: "numeric",
});
const tocHeadings = headings.filter((h) => h.depth <= 3);

const currentSlug = Astro.url.pathname.replace(/\/$/, "").split("/").pop();

const allCaseStudies = await getCollection("case-studies");
const allBlogs = await getCollection("blog");

const sortedCaseStudies = allCaseStudies.sort(
  (a, b) =>
    new Date(b.data.publishedAt || 0).getTime() -
    new Date(a.data.publishedAt || 0).getTime(),
);

const currentIndex = sortedCaseStudies.findIndex(
  (cs) => cs.slug === currentSlug,
);

let nextItem:
  | { title: string; href: string; type: "Case Study" | "Blog" }
  | undefined;

if (currentIndex !== -1) {
  if (currentIndex < sortedCaseStudies.length - 1) {
    const next = sortedCaseStudies[currentIndex + 1];
    nextItem = {
      title: next.data.title,
      href: `/case-studies/${next.slug}`,
      type: "Case Study",
    };
  } else {
    const currentTags = frontmatter.tags;
    const relatedBlog = allBlogs
      .map((blog) => ({
        blog,
        matches: blog.data.tags.filter((tag: string) =>
          currentTags.includes(tag),
        ).length,
      }))
      .filter(({ matches }) => matches > 0)
      .sort((a, b) => b.matches - a.matches)[0]?.blog;

    if (relatedBlog) {
      nextItem = {
        title: relatedBlog.data.title,
        href: `/blog/${relatedBlog.slug}`,
        type: "Blog",
      };
    } else if (allBlogs.length > 0) {
      const firstBlog = allBlogs[0];
      nextItem = {
        title: firstBlog.data.title,
        href: `/blog/${firstBlog.slug}`,
        type: "Blog",
      };
    }
  }
}
---

<Layout
  title={`${frontmatter.title} Case Study | ${frontmatter.tags[0] || "Technical"} | ${SITE.name}`}
  description={frontmatter.description.length > 50
    ? frontmatter.description
    : `A detailed case study by ${SITE.name}, ${SITE.title}, on building ${frontmatter.title}.`}
>
  <article class="case-study container wide">
    <div class="case-study-grid">
      <div class="main-content">
        <header class="case-study-header">
          <a href="/case-studies" class="back-link">← Case Studies</a>

          <h1 class="title">{frontmatter.title}</h1>

          <div class="header-meta">
            <div class="meta-item">
              <span class="meta-label">Published</span>
              <time
                class="meta-value"
                datetime={frontmatter.publishedAt.toISOString()}
                >{formattedDate}</time
              >
            </div>
            <div class="meta-item">
              <span class="meta-label">Impact</span>
              <span class="meta-value highlight"
                >{frontmatter.metrics.join(" · ")}</span
              >
            </div>
          </div>
        </header>

        <slot />


        <ContentNavigation
          backLabel="All case studies"
          backHref="/case-studies"
          nextItem={nextItem}
        />
      </div>

      <aside class="sidebar">
        <div class="sticky-content">

          <div class="sidebar-top">
            <div class="sidebar-section">
              <h3 class="sidebar-title mono">Tech Stack</h3>
              <div class="tech-stack">
                {
                  frontmatter.tags.map((tag) => (
                    <span class="tech-badge mono">{tag}</span>
                  ))
                }
              </div>
            </div>
          </div>


          <div class="sidebar-middle">
            <div class="sidebar-section">
              <h3 class="sidebar-title mono">On this page</h3>
              <nav class="toc">
                <ul>
                  {
                    tocHeadings.map((heading) => (
                      <li>
                        <a
                          href={`#${heading.slug}`}
                          class={`toc-link depth-${heading.depth} mono`}
                        >
                          {heading.text}
                        </a>
                      </li>
                    ))
                  }
                </ul>
              </nav>
            </div>
          </div>


          <div class="sidebar-bottom"></div>
        </div>
      </aside>
    </div>
  </article>
</Layout>

<style>
  .case-study {
    padding-block: var(--space-12);
  }

  .container.wide {
    max-width: 1280px;
  }

  .case-study-header {
    margin-bottom: var(--space-12);
    padding-bottom: var(--space-8);
    max-width: var(--content-width);
  }

  .back-link {
    display: inline-block;
    font-size: var(--text-small);
    color: var(--color-text-muted);
    margin-bottom: var(--space-8);
    transition: color var(--transition-fast);
  }

  .back-link:hover {
    color: var(--color-text-primary);
  }

  .title {
    font-size: var(--text-h1);
    margin-bottom: var(--space-2);
  }

  .header-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-8);
    padding-top: var(--space-4);
  }

  .meta-item {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .meta-label {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
  }

  .meta-value {
    font-size: var(--text-small);
  }

  .meta-value.highlight {
    color: var(--color-text-primary);
    font-weight: 600;
  }

  .case-study-grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .sidebar {
    display: none;
  }

  @media (min-width: 1280px) {
    .case-study-grid {
      display: grid;
      grid-template-columns: 1fr 300px;
      gap: var(--space-32);
    }

    .sidebar {
      display: block;
      height: 100%;
    }

    .sticky-content {
      position: sticky;
      top: 0;
      height: 100vh;
      display: flex;
      flex-direction: column;
      padding-block: 0;
      overflow: hidden;
    }

    .sidebar-top {
      height: 20%;
      display: flex;
      flex-direction: column;
      justify-content: flex-start;
      padding-top: 10px;
      padding-bottom: 32px;
      border-bottom: 1px solid var(--color-border);
      overflow-y: auto;
      scrollbar-width: none;
      -ms-overflow-style: none;
    }

    .sidebar-top::-webkit-scrollbar {
      display: none;
    }

    .sidebar-middle {
      height: 60%;
      overflow-y: auto;
      padding-top: 32px;
      padding-bottom: 20px;

      scrollbar-width: none;
      -ms-overflow-style: none;
    }

    .sidebar-middle::-webkit-scrollbar {
      display: none;
    }

    .sidebar-bottom {
      height: 20%;
    }
  }

  .sidebar-title {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    text-transform: uppercase;
    margin-bottom: var(--space-4);
    letter-spacing: 0.05em;
  }

  .toc ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .toc-link {
    font-size: var(--text-xs);
    text-decoration: none;
    color: var(--color-text-muted);
    display: block;
    transition:
      opacity 0.2s ease,
      color 0.2s ease;
    border-left: 1px solid transparent;
    padding-left: 0;
  }

  .toc-link:hover {
    color: var(--color-text-primary);
  }

  .toc-link.active {
    color: var(--color-text-primary);
    opacity: 1;
    font-weight: 500;
  }

  .toc-link.depth-3 {
    padding-left: var(--space-4);
  }

  .tech-stack {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .tech-badge {
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    background: var(--color-bg-surface);
    padding: var(--space-1) var(--space-2);
    border-radius: 4px;
  }

  .main-content {
    min-width: 0;
  }

  .main-content :global(h2) {
    font-size: var(--text-h2);
    margin-top: var(--space-16);
    margin-bottom: var(--space-4);
    scroll-margin-top: var(--space-8);
  }

  .main-content :global(h3) {
    font-size: var(--text-h3);
    margin-top: var(--space-10);
    margin-bottom: var(--space-3);
    scroll-margin-top: var(--space-8);
  }

  .main-content :global(p) {
    margin-bottom: var(--space-4);
    line-height: 1.75;
    font-size: var(--text-body);
  }

  .main-content :global(ul),
  .main-content :global(ol) {
    margin-bottom: var(--space-4);
    padding-left: var(--space-6);
  }

  .main-content :global(li) {
    margin-bottom: var(--space-2);
    line-height: 1.65;
  }

  .main-content :global(code) {
    font-family: var(--font-mono);
    font-size: 0.9em;
    background-color: var(--color-bg-surface);
    padding: 0.15em 0.4em;
    border-radius: 4px;
    color: var(--color-text-primary);
  }

  .main-content :global(pre) {
    background-color: var(--color-bg-surface);
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    padding: var(--space-4);
    overflow-x: auto;
    margin-bottom: var(--space-6);
    font-size: 0.9em;
  }

  .main-content :global(pre code) {
    background: none;
    padding: 0;
    color: inherit;
  }

  .main-content :global(blockquote) {
    border-left: 3px solid var(--color-accent);
    padding-left: var(--space-4);
    margin-left: 0;
    margin-bottom: var(--space-4);
    color: var(--color-text-secondary);
    font-style: italic;
  }

  .main-content :global(img) {
    max-width: 100%;
    border-radius: 0.5rem;
    margin-block: var(--space-6);
  }

  .main-content :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: var(--space-8);
    font-size: var(--text-small);
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    overflow: hidden;
  }

  .main-content :global(th),
  .main-content :global(td) {
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--color-border);
    text-align: left;
    vertical-align: top;
  }

  .main-content :global(th) {
    background-color: var(--color-bg-surface);
    font-weight: 600;
    color: var(--color-text-primary);
    white-space: nowrap;
  }

  .main-content :global(td) {
    color: var(--color-text-secondary);
  }

  .main-content :global(tr:last-child td) {
    border-bottom: none;
  }

  .main-content :global(tr:hover td) {
    background-color: var(--color-bg-surface);
    transition: background-color 0.2s ease;
  }
</style>
