---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import CommandPalette from "../components/CommandPalette.astro";
import MermaidInit from "../components/MermaidInit.astro";
import { SEO } from "../config/site";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = SEO.defaultTitle,
  description = SEO.defaultDescription,
} = Astro.props;

const canonicalURL = Astro.site
  ? new URL(Astro.url.pathname, Astro.site)
  : Astro.url;

const socialImageURL = new URL("/og-image.png", Astro.url);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />

    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImageURL} />

    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />

    <link
      rel="preload"
      href="/fonts/GeistVF.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/GeistMonoVF.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <ClientRouter />
  </head>
  <body>
    <main>
      <slot />
    </main>
    <CommandPalette />
    <MermaidInit />
    <script>
      function initBackLinks() {
        const savedHash = sessionStorage.getItem('home-section');
        if (savedHash) {
          document.querySelectorAll('.back-link[href="/"]').forEach((link) => {
            link.setAttribute('href', `/#${savedHash}`);
          });
        }
      }

      document.addEventListener('astro:page-load', initBackLinks);
      initBackLinks();
    </script>
    <script>
      let tocAbortController: AbortController | null = null;
      let tocObserver: IntersectionObserver | null = null;

      function initToc() {
        if (tocAbortController) tocAbortController.abort();
        if (tocObserver) { tocObserver.disconnect(); tocObserver = null; }

        const tocLinks = document.querySelectorAll(".toc-link");
        const headings = document.querySelectorAll(
          ".main-content h2, .main-content h3",
        );
        if (!tocLinks.length && !headings.length) return;

        tocAbortController = new AbortController();
        const { signal } = tocAbortController;

        const tocContainer = document.querySelector(".sidebar-middle");
        let currentActiveId = "";
        let isManualScrolling = false;
        let manualScrollTimer: number;

        const setActive = (id: string, forceContainerScroll = false) => {
          if (id === currentActiveId || !id) return;
          currentActiveId = id;

          tocLinks.forEach((link) => {
            link.classList.remove("active");
            link.classList.add("text-muted");
          });

          const activeLink = document.querySelector(`.toc-link[href="#${id}"]`);
          if (activeLink) {
            activeLink.classList.remove("text-muted");
            activeLink.classList.add("active");

            if (tocContainer && (!isManualScrolling || forceContainerScroll)) {
              const link = activeLink as HTMLElement;
              const container = tocContainer as HTMLElement;

              const linkTop = link.offsetTop;
              const containerScrollTop = container.scrollTop;
              const containerHeight = container.offsetHeight;

              if (
                linkTop < containerScrollTop + 20 ||
                linkTop > containerScrollTop + containerHeight - 40
              ) {
                container.scrollTo({
                  top: linkTop - containerHeight / 2,
                  behavior: "smooth" as ScrollBehavior,
                });
              }
            }
          }
        };

        tocLinks.forEach((link) => {
          link.addEventListener("click", () => {
            isManualScrolling = true;
            if (manualScrollTimer) clearTimeout(manualScrollTimer);

            const id = link.getAttribute("href")?.substring(1);
            if (id) setActive(id, true);

            manualScrollTimer = window.setTimeout(() => {
              isManualScrolling = false;
            }, 1000);
          }, { signal });
        });

        tocObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting && !isManualScrolling) {
                setActive(entry.target.getAttribute("id") || "");
              }
            });
          },
          {
            rootMargin: "-10% 0px -70% 0px",
          },
        );

        headings.forEach((heading) => tocObserver!.observe(heading));

        let scrollTimeout: number;
        window.addEventListener("scroll", () => {
          if (scrollTimeout) return;

          scrollTimeout = window.setTimeout(() => {
            if (
              window.innerHeight + window.scrollY >=
              document.documentElement.scrollHeight - 50
            ) {
              if (headings.length > 0) {
                const lastHeading = headings[headings.length - 1];
                setActive(lastHeading.id);
              }
            }
            scrollTimeout = 0;
          }, 100);
        }, { signal });
      }

      document.addEventListener('astro:page-load', initToc);
      initToc();
    </script>
  </body>
</html>
