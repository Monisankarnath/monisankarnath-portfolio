---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import CommandPalette from "../components/CommandPalette.astro";
import MermaidInit from "../components/MermaidInit.astro";
import { SEO, SITE, CONTACT } from "../config/site";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = SEO.defaultTitle,
  description = SEO.defaultDescription,
} = Astro.props;

const canonicalURL = Astro.site
  ? new URL(Astro.url.pathname, Astro.site)
  : Astro.url;

const socialImageURL = new URL("/og-image.png", Astro.url);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#0E1116" />
    <link rel="apple-touch-icon" href="/icons/icon-192.png" />

    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImageURL} />

    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={socialImageURL} />

    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      "name": SITE.name,
      "url": SITE.url,
      "jobTitle": SITE.title,
      "sameAs": [
        CONTACT.github.url,
        CONTACT.linkedin.url,
        CONTACT.youtube.url,
      ],
    })} />

    <link
      rel="preload"
      href="/fonts/GeistVF.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/GeistMonoVF.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <ClientRouter />
  </head>
  <body>
    <main>
      <slot />
    </main>
    <CommandPalette />
    <MermaidInit />
    <div id="mermaid-modal" class="mermaid-modal" aria-hidden="true">
      <div class="mermaid-modal-backdrop"></div>
      <div class="mermaid-modal-content"></div>
    </div>
    <script>
      function initBackLinks() {
        const savedHash = sessionStorage.getItem('home-section');
        if (savedHash) {
          document.querySelectorAll('.back-link[href="/"]').forEach((link) => {
            link.setAttribute('href', `/#${savedHash}`);
          });
        }
      }

      document.addEventListener('astro:page-load', initBackLinks);
      initBackLinks();
    </script>
    <script>
      let heroAbort: AbortController | null = null;

      function initSearchButton() {
        if (heroAbort) heroAbort.abort();
        const btn = document.getElementById('open-search');
        if (!btn) return;

        heroAbort = new AbortController();
        btn.addEventListener('click', () => {
          document.dispatchEvent(new CustomEvent('open-command-palette'));
        }, { signal: heroAbort.signal });
      }

      document.addEventListener('astro:page-load', initSearchButton);
      initSearchButton();
    </script>
    <script>
      let tocAbortController: AbortController | null = null;
      let tocObserver: IntersectionObserver | null = null;

      function initToc() {
        if (tocAbortController) tocAbortController.abort();
        if (tocObserver) { tocObserver.disconnect(); tocObserver = null; }

        const tocLinks = document.querySelectorAll(".toc-link");
        const headings = document.querySelectorAll(
          ".main-content h2, .main-content h3",
        );
        if (!tocLinks.length && !headings.length) return;

        tocAbortController = new AbortController();
        const { signal } = tocAbortController;

        const tocContainer = document.querySelector(".sidebar-middle");
        let currentActiveId = "";
        let isManualScrolling = false;
        let manualScrollTimer: number;

        const setActive = (id: string, forceContainerScroll = false) => {
          if (id === currentActiveId || !id) return;
          currentActiveId = id;

          tocLinks.forEach((link) => {
            link.classList.remove("active");
            link.classList.add("text-muted");
          });

          const activeLink = document.querySelector(`.toc-link[href="#${id}"]`);
          if (activeLink) {
            activeLink.classList.remove("text-muted");
            activeLink.classList.add("active");

            if (tocContainer && (!isManualScrolling || forceContainerScroll)) {
              const link = activeLink as HTMLElement;
              const container = tocContainer as HTMLElement;

              const linkTop = link.offsetTop;
              const containerScrollTop = container.scrollTop;
              const containerHeight = container.offsetHeight;

              if (
                linkTop < containerScrollTop + 20 ||
                linkTop > containerScrollTop + containerHeight - 40
              ) {
                container.scrollTo({
                  top: linkTop - containerHeight / 2,
                  behavior: "smooth" as ScrollBehavior,
                });
              }
            }
          }
        };

        tocLinks.forEach((link) => {
          link.addEventListener("click", () => {
            isManualScrolling = true;
            if (manualScrollTimer) clearTimeout(manualScrollTimer);

            const id = link.getAttribute("href")?.substring(1);
            if (id) setActive(id, true);

            manualScrollTimer = window.setTimeout(() => {
              isManualScrolling = false;
            }, 1000);
          }, { signal });
        });

        tocObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting && !isManualScrolling) {
                setActive(entry.target.getAttribute("id") || "");
              }
            });
          },
          {
            rootMargin: "-10% 0px -70% 0px",
          },
        );

        headings.forEach((heading) => tocObserver!.observe(heading));

        let scrollTimeout: number;
        window.addEventListener("scroll", () => {
          if (scrollTimeout) return;

          scrollTimeout = window.setTimeout(() => {
            if (
              window.innerHeight + window.scrollY >=
              document.documentElement.scrollHeight - 50
            ) {
              if (headings.length > 0) {
                const lastHeading = headings[headings.length - 1];
                setActive(lastHeading.id);
              }
            }
            scrollTimeout = 0;
          }, 100);
        }, { signal });
      }

      document.addEventListener('astro:page-load', initToc);
      initToc();
    </script>
    <script>
      let isTraversal = false;
      let homeObserver: IntersectionObserver | null = null;
      let hashObserver: IntersectionObserver | null = null;

      document.addEventListener('astro:before-swap', ((e: any) => {
        isTraversal = e.navigationType === 'traverse';
      }) as EventListener);

      function initHomepage() {
        if (homeObserver) { homeObserver.disconnect(); homeObserver = null; }
        if (hashObserver) { hashObserver.disconnect(); hashObserver = null; }

        const sections = document.querySelectorAll('.section-animate');

        if (isTraversal) {
          isTraversal = false;
          sections.forEach((el) => el.classList.add('visible'));
          const hash = window.location.hash.substring(1);
          if (hash) {
            const target = document.getElementById(hash);
            if (target) {
              requestAnimationFrame(() => target.scrollIntoView());
            }
          }
        } else if (sections.length && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          homeObserver = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  entry.target.classList.add('visible');
                  homeObserver?.unobserve(entry.target);
                }
              });
            },
            { threshold: 0.1 }
          );
          sections.forEach((el) => homeObserver!.observe(el));
        } else {
          sections.forEach((el) => el.classList.add('visible'));
        }

        const hashSections = document.querySelectorAll('section[id]');
        if (!hashSections.length) return;

        hashObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                const id = entry.target.getAttribute('id');
                if (id === 'top') {
                  history.replaceState(history.state, '', '/');
                  sessionStorage.removeItem('home-section');
                } else if (id) {
                  history.replaceState(history.state, '', `/#${id}`);
                  sessionStorage.setItem('home-section', id);
                }
              }
            });
          },
          { rootMargin: '-20% 0px -70% 0px' }
        );

        hashSections.forEach((section) => hashObserver!.observe(section));
      }

      document.addEventListener('astro:page-load', initHomepage);
      initHomepage();
    </script>
    <script>
      let mermaidModalAbort: AbortController | null = null;

      function initMermaidModal() {
        if (mermaidModalAbort) mermaidModalAbort.abort();

        const modal = document.getElementById('mermaid-modal');
        const modalContent = modal?.querySelector('.mermaid-modal-content');
        const backdrop = modal?.querySelector('.mermaid-modal-backdrop');
        const diagrams = document.querySelectorAll('pre.mermaid');
        if (!modal || !modalContent || !backdrop || !diagrams.length) return;

        mermaidModalAbort = new AbortController();
        const { signal } = mermaidModalAbort;

        function openModal(svg: SVGElement) {
          const clone = svg.cloneNode(true) as SVGElement;
          clone.removeAttribute('style');
          clone.setAttribute('width', '100%');
          clone.setAttribute('height', '100%');
          clone.style.maxWidth = '100%';
          clone.style.maxHeight = '100%';
          modalContent!.innerHTML = '';
          modalContent!.appendChild(clone);
          modal!.setAttribute('aria-hidden', 'false');
          document.body.style.overflow = 'hidden';
        }

        function closeModal() {
          modal!.setAttribute('aria-hidden', 'true');
          document.body.style.overflow = '';
          setTimeout(() => {
            modalContent!.innerHTML = '';
          }, 300);
        }

        diagrams.forEach((diagram) => {
          diagram.addEventListener('click', () => {
            const svg = diagram.querySelector('svg');
            if (svg) openModal(svg);
          }, { signal });
        });

        backdrop.addEventListener('click', closeModal, { signal });

        modalContent.addEventListener('click', (e) => {
          if (e.target === modalContent) closeModal();
        }, { signal });

        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && modal.getAttribute('aria-hidden') === 'false') {
            closeModal();
          }
        }, { signal });
      }

      document.addEventListener('mermaid:rendered', initMermaidModal);
    </script>
    <script>
      if ('serviceWorker' in navigator) {
        navigator.serviceWorker.register('/sw.js');
      }
    </script>
  </body>
</html>
