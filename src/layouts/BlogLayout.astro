---
import Layout from "./Layout.astro";
import ContentNavigation from "../components/ContentNavigation.astro";
import MermaidInit from "../components/MermaidInit.astro";
import { getCollection } from "astro:content";
import { SITE } from "../config/site";

interface Props {
  frontmatter: {
    title: string;
    description: string;
    publishedAt: Date;
    updatedAt?: Date;
    tags: string[];
  };
  rawContent: string;
}

const { frontmatter, rawContent } = Astro.props;

const wordCount = rawContent.split(/\s+/).length;
const readingTime = Math.ceil(wordCount / 200);

const formatDate = (date: Date) => {
  return date.toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
};

const currentSlug = Astro.url.pathname.split("/").pop();

const allBlogs = await getCollection("blog");
const allCaseStudies = await getCollection("case-studies");

const sortedBlogs = allBlogs.sort(
  (a, b) => new Date(b.data.publishedAt).getTime() - new Date(a.data.publishedAt).getTime()
);

const currentIndex = sortedBlogs.findIndex((blog) => blog.slug === currentSlug);

let nextItem: { title: string; href: string; type: "Case Study" | "Blog" } | undefined;

if (currentIndex !== -1) {
  if (currentIndex < sortedBlogs.length - 1) {
    const next = sortedBlogs[currentIndex + 1];
    nextItem = {
      title: next.data.title,
      href: `/blog/${next.slug}`,
      type: "Blog",
    };
  } else {
    const currentTags = frontmatter.tags;
    const relatedCaseStudy = allCaseStudies
      .map((caseStudy) => ({
        caseStudy,
        matches: caseStudy.data.tags.filter((tag: string) => currentTags.includes(tag)).length,
      }))
      .filter(({ matches }) => matches > 0)
      .sort((a, b) => b.matches - a.matches)[0]?.caseStudy;

    if (relatedCaseStudy) {
      nextItem = {
        title: relatedCaseStudy.data.title,
        href: `/case-studies/${relatedCaseStudy.slug}`,
        type: "Case Study",
      };
    } else if (allCaseStudies.length > 0) {
      const firstCaseStudy = allCaseStudies[0];
      nextItem = {
        title: firstCaseStudy.data.title,
        href: `/case-studies/${firstCaseStudy.slug}`,
        type: "Case Study",
      };
    }
  }
}
---

<Layout
  title={`${frontmatter.title} | ${SITE.name}`}
  description={frontmatter.description}
>
  <article class="blog-post container">
    <header class="post-header">
      <a href="/blog" class="back-link">← All posts</a>

      <h1 class="title">{frontmatter.title}</h1>

      <div class="meta mono text-muted">
        <time datetime={frontmatter.publishedAt.toISOString()}>
          {formatDate(frontmatter.publishedAt)}
        </time>
        <span class="separator">·</span>
        <span>{readingTime} min read</span>
      </div>

      {
        frontmatter.tags.length > 0 && (
          <div class="tags">
            {frontmatter.tags.map((tag) => (
              <span class="tag mono">{tag}</span>
            ))}
          </div>
        )
      }
    </header>

    <div class="content">
      <slot />
    </div>


    <ContentNavigation
      backLabel="All posts"
      backHref="/blog"
      nextItem={nextItem}
    />
  </article>
  <MermaidInit />
</Layout>

<style>
  .blog-post {
    padding-block: var(--space-12);
  }

  .post-header {
    margin-bottom: var(--space-12);
    padding-bottom: var(--space-8);
  }

  .back-link {
    display: inline-block;
    font-size: var(--text-small);
    color: var(--color-text-muted);
    margin-bottom: var(--space-8);
    transition: color var(--transition-fast);
  }

  .back-link:hover {
    color: var(--color-text-primary);
  }

  .title {
    font-size: var(--text-h1);
    margin-bottom: var(--space-4);
  }

  .meta {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-small);
  }

  .separator {
    opacity: 0.5;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-4);
  }

  .tag {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    background-color: var(--color-bg-surface);
    padding: var(--space-1) var(--space-3);
    border-radius: 9999px;
    border: 1px solid var(--color-border);
  }

  .content {
    max-width: var(--content-width);
  }

  .content :global(h2) {
    font-size: var(--text-h2);
    margin-top: var(--space-12);
    margin-bottom: var(--space-4);
  }

  .content :global(h3) {
    font-size: var(--text-h3);
    margin-top: var(--space-8);
    margin-bottom: var(--space-3);
  }

  .content :global(p) {
    margin-bottom: var(--space-4);
    line-height: 1.75;
  }

  .content :global(ul),
  .content :global(ol) {
    margin-bottom: var(--space-4);
    padding-left: var(--space-6);
  }

  .content :global(li) {
    margin-bottom: var(--space-2);
    line-height: 1.65;
  }

  .content :global(code) {
    font-family: var(--font-mono);
    font-size: 0.9em;
    background-color: var(--color-bg-surface);
    padding: 0.15em 0.4em;
    border-radius: 4px;
  }

  .content :global(pre) {
    background-color: var(--color-bg-surface);
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    padding: var(--space-4);
    overflow-x: auto;
    margin-bottom: var(--space-6);
  }

  .content :global(pre code) {
    background: none;
    padding: 0;
  }

  .content :global(blockquote) {
    border-left: 3px solid var(--color-accent);
    padding-left: var(--space-4);
    margin-left: 0;
    margin-bottom: var(--space-4);
    color: var(--color-text-secondary);
    font-style: italic;
  }

  .content :global(img) {
    max-width: 100%;
    border-radius: 0.5rem;
    margin-block: var(--space-6);
  }

  .content :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: var(--space-8);
    font-size: var(--text-small);
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    overflow: hidden;
  }

  .content :global(th),
  .content :global(td) {
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--color-border);
    text-align: left;
    vertical-align: top;
  }

  .content :global(th) {
    background-color: var(--color-bg-surface);
    font-weight: 600;
    color: var(--color-text-primary);
    white-space: nowrap;
  }

  .content :global(td) {
    color: var(--color-text-secondary);
  }

  .content :global(tr:last-child td) {
    border-bottom: none;
  }

  .content :global(tr:hover td) {
    background-color: var(--color-bg-surface);
    transition: background-color 0.2s ease;
  }
</style>
